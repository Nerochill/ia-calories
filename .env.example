# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# --- Clerk (auth) ---  https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the `user.created` / `user.deleted` webhook (src/app/api/webhooks/clerk+api.ts)
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Database (Postgres, e.g. Neon) ---
DATABASE_URL=

# --- OpenAI (meal photo analysis + nutrition targets) ---
OPENAI_API_KEY=
# Optional, defaults to the model set in src/lib/server/openai-meal.ts
OPENAI_MODEL=

# --- ImageKit (meal photo storage) ---  https://imagekit.io/dashboard
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Trigger.dev (background meal analysis) ---  https://cloud.trigger.dev
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# --- Sentry (optional: errors + feedback) ---
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
